# Reference MEND configuration (explicit proposals). Read by infra/mend_task_lib.sh best_mend_flags when
# BEST_MEND_ENV points here; each variable maps to one --config.mend.* flag of configs/mend.py.
# Paper headline recipe: explicit proposals, single-state target, AdamW epsilon 1e-12.
MEND_PROPOSAL=explicit            # explicit (the method) | anchored (restart ablation)
MEND_RESTART_CORRECTION=delta     # anchored ablation only
MEND_RESTART_ORDER=1              # anchored ablation only
MEND_CAP_MODE=group               # group | cluster
MEND_Q=0.75                       # group-cap quantile
MEND_CLUSTER_Q=0.75               # per-cluster quantile when MEND_CAP_MODE=cluster
MEND_LAMBDA_KEEP=10               # weight of the keep term for seeds already at the cap
MEND_TARGET_MODE=single_state_x0  # regress the certified move as an x0 shift at one rollout state
MEND_VERDICT=1                    # proximal verdict on (0 = ablation that always takes the middle step size)
MEND_TAU_INIT=0.1
MEND_LR=0.0003
# Extra trainer flags, space separated (no spaces inside a value; sequences are tuples).
MEND_EXTRA_FLAGS="--config.mend.etas_explicit=(0.1,0.2,0.4) --config.train.adam_epsilon=1e-12 --config.mend.d_fixed_rms=0.0"
